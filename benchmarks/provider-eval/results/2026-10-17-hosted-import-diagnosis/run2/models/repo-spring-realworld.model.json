  "openQuestions": [
    {
      "id": "q.runtime.wiring",
      "text": "Only one dependency edge (UserService to UserRepository) was extracted. How do the API controllers wire to the query, command and repository classes at runtime?"
    },
    {
      "id": "q.datastore",
      "text": "The MyBatis repositories imply a database, but none appears in the fragment. Which datastore backs them?"
    },
    {
      "id": "q.userrepository.impl",
      "text": "Is UserRepository implemented by MyBatisUserRepository? The fragment does not bind them."
    },
