  "title": "Video Streaming Platform",
  "requirements": [
    {
      "id": "req.clients",
      "text": "Viewers use web and TV apps through a CDN",
      "status": "stated"
    },
    {
      "id": "req.gateway",
      "text": "API gateway routes to catalog, playback and recommendation services",
      "status": "stated"
    },
    {
      "id": "req.events",
      "text": "Playback writes view events to Kafka, consumed by analytics service",
      "status": "stated"
    },
    {
      "id": "req.analytics-store",
      "text": "Analytics stores aggregates in ClickHouse",
      "status": "stated"
    },
    {
      "id": "req.accounts",
      "text": "User accounts in PostgreSQL, sessions in Redis",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "q.accounts-owner",
      "text": "Which service owns user accounts and sessions? An account service is proposed.",
      "blockedBy": "svc.accounts"
    },
    {
      "id": "q.catalog-store",
      "text": "Where do catalog and recommendation services persist their data?",
      "blockedBy": null
    }
  ],
