{
  "schemaVersion": "1",
  "revision": 1,
  "title": "Multi-tenant Project Tracker Data Model",
  "requirements": [
    {
      "id": "req.tenancy",
      "text": "Organizations are the tenant root and own users and projects",
      "status": "stated"
    },
    {
      "id": "req.tasks",
      "text": "Projects have tasks",
      "status": "stated"
    },
    {
      "id": "req.assignee",
      "text": "Each task has an assignee, which is a user",
      "status": "stated"
    },
    {
      "id": "req.comments",
      "text": "Tasks have comments",
      "status": "stated"
    },
    {
      "id": "req.labels",
      "text": "Tasks and labels are many-to-many",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "q.assignee-optional",
      "text": "Can a task be unassigned (nullable assignee_id)?",
      "blockedBy": null
    },
    {
      "id": "q.label-scope",
      "text": "Are labels scoped per organization or per project?",
      "blockedBy": "e.org-labels"
    },
    {
      "id": "q.comment-author",
      "text": "Should comments record the authoring user?",
      "blockedBy": "e.user-comments"
    }
  ],
