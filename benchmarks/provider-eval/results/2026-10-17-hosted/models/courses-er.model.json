    {
      "id": "req.courses",
      "text": "Instructors create courses",
      "status": "stated"
    },
    {
      "id": "req.lessons",
      "text": "Courses contain ordered lessons",
      "status": "stated"
    },
    {
      "id": "req.enroll",
      "text": "Students enroll in courses",
      "status": "stated"
    },
    {
      "id": "req.progress",
      "text": "Each enrollment tracks progress per lesson",
      "status": "stated"
    },
    {
      "id": "req.cert",
      "text": "Each enrollment has a final certificate",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "q.coauthors",
      "text": "Can a course have multiple instructors (co-authors)? Currently modeled as one instructor per course.",
      "blockedBy": "e.instructor-course"
    },
    {
      "id": "q.users",
      "text": "Can one person be both instructor and student? If so, a shared user entity may be preferable.",
      "blockedBy": null
    }
