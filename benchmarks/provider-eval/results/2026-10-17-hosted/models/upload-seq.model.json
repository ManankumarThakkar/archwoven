  "title": "Direct-to-S3 File Upload with Virus Scan",
  "requirements": [
    {
      "id": "req.presigned",
      "text": "Browser obtains a pre-signed S3 URL from the API",
      "status": "stated"
    },
    {
      "id": "req.direct-upload",
      "text": "Browser uploads the file directly to S3",
      "status": "stated"
    },
    {
      "id": "req.notify",
      "text": "Browser notifies the API after upload; API enqueues a virus scan",
      "status": "stated"
    },
    {
      "id": "req.scan-result",
      "text": "Scanner marks the file clean or quarantined",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "oq.status-store",
      "text": "Where is the clean/quarantined status recorded (file metadata DB, S3 object tags, or a separate quarantine bucket)?",
      "blockedBy": "e.scanner-files"
    },
    {
      "id": "oq.scanner-read",
      "text": "Does the scanner fetch the object from S3 itself, or receive the file another way?",
      "blockedBy": "e.scanner-s3"
    }
  ],
