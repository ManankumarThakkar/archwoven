  "title": "Video Streaming Platform",
  "requirements": [
    {
      "id": "req.clients",
      "text": "Viewers use web and TV apps through a CDN",
      "status": "stated"
    },
    {
      "id": "req.gateway",
      "text": "API gateway routes to catalog, playback and recommendation services",
      "status": "stated"
    },
    {
      "id": "req.events",
      "text": "Playback writes view events to Kafka",
      "status": "stated"
    },
    {
      "id": "req.analytics",
      "text": "Analytics service consumes view events and stores aggregates in ClickHouse",
      "status": "stated"
    },
    {
      "id": "req.accounts",
      "text": "User accounts live in PostgreSQL",
      "status": "stated"
    },
    {
      "id": "req.sessions",
      "text": "Sessions live in Redis",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "q.accounts-owner",
      "text": "Which service owns user accounts and sessions? An account service is proposed.",
      "blockedBy": "e.gateway-accounts"
    },
    {
      "id": "q.catalog-store",
      "text": "Where does the catalog service store its metadata?",
      "blockedBy": null
    },
    {
      "id": "q.reco-data",
      "text": "Does recommendation read analytics aggregates from ClickHouse?",
      "blockedBy": null
    }
  ],
