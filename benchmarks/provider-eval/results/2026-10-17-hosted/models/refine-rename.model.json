{
  "schemaVersion": "1",
  "revision": 2,
  "parentId": 1,
  "title": "Ride-Hailing Platform Architecture",
  "requirements": [
    {
      "id": "req.realtime-location",
      "text": "Rider and driver mobile apps talk to an API over WebSockets for live location.",
      "status": "stated"
    },
    {
      "id": "req.matching",
      "text": "A matching service pairs riders with nearby drivers using a geospatial index in Redis.",
      "status": "stated"
    },
    {
      "id": "req.trip-storage",
      "text": "Trips are stored in PostgreSQL.",
      "status": "stated"
    },
    {
      "id": "req.payments",
      "text": "Payments go through Stripe.",
      "status": "stated"
    },
    {
      "id": "req.push",
      "text": "Push notifications go through Firebase.",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "q.trip-owner",
      "text": "Which component owns trip records and calls Stripe? A trip service is assumed here.",
      "blockedBy": "svc.trips"
    },
    {
      "id": "q.push-sender",
      "text": "Which services send push notifications through Firebase?",
      "blockedBy": "e.matching-firebase"
    },
    {
      "id": "q.location-write",
      "text": "Does the API or the matching service write driver locations into the Redis geo index?",
      "blockedBy": "e.matching-redis"
    }
  ],
