  "title": "Password Reset Flow",
  "requirements": [
    {
      "id": "req.request-link",
      "text": "User requests a password reset link",
      "status": "stated"
    },
    {
      "id": "req.token-redis",
      "text": "Account service generates a one-time token and stores it in Redis with a 15-minute expiry",
      "status": "stated"
    },
    {
      "id": "req.email-ses",
      "text": "Reset link is emailed through SES",
      "status": "stated"
    },
    {
      "id": "req.verify-delete",
      "text": "When the link is opened, the token is verified and deleted",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "q.invalid-token",
      "text": "What should the user see when the token is expired or invalid?",
      "blockedBy": null
    },
    {
      "id": "q.password-update",
      "text": "Where is the new password submitted and stored after the token is verified?",
      "blockedBy": null
    },
    {
      "id": "q.unknown-email",
      "text": "Should the response differ when the email has no account, or always be generic?",
      "blockedBy": null
    }
  ],
