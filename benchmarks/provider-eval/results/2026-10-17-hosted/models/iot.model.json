  "title": "Temperature Sensor Telemetry Platform",
  "requirements": [
    {
      "id": "req.ingest",
      "text": "Thousands of temperature sensors publish readings over MQTT to a broker.",
      "status": "stated"
    },
    {
      "id": "req.validate",
      "text": "An ingestion service validates readings and writes them to TimescaleDB.",
      "status": "stated"
    },
    {
      "id": "req.alert",
      "text": "An alerting service watches thresholds and pages on-call engineers through PagerDuty.",
      "status": "stated"
    },
    {
      "id": "req.dashboard",
      "text": "A Grafana dashboard reads from TimescaleDB.",
      "status": "stated"
    }
  ],
  "openQuestions": [
    {
      "id": "oq.alert-source",
      "text": "Does the alerting service query TimescaleDB or subscribe to the MQTT broker directly?",
      "blockedBy": "e.alerting-timescaledb"
    },
    {
      "id": "oq.invalid-readings",
      "text": "What happens to readings that fail validation (drop, log, dead-letter)?",
      "blockedBy": null
    }
