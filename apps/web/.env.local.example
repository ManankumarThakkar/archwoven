# Copy to .env.local (gitignored) and fill in.
#
# Two deployment modes — pick one:
#
# 1) LOCAL (private, free): all generation stays on this machine via Ollama.
#    Requires: ollama serve + `ollama pull gpt-oss:20b`
ARCHWOVEN_MODE=local
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gpt-oss:20b
#
# 2) HOSTED: generation calls the Anthropic API.
#    Comment out ARCHWOVEN_MODE above and set your key:
# ANTHROPIC_API_KEY=sk-ant-…
