{
  "nodes": [
    { "kind": "service", "label": "OrderController" },
    { "kind": "service", "label": "ProductController" },
    { "kind": "service", "label": "OrderService" },
    { "kind": "service", "label": "ProductService" },
    { "kind": "service", "label": "OrderRepository" },
    { "kind": "service", "label": "ProductRepository" },
    { "kind": "service", "label": "HomeController" },
    { "kind": "service", "label": "NotificationService" },
    { "kind": "external", "label": "pricing.example.com" },
    { "kind": "entity", "label": "Order" },
    { "kind": "entity", "label": "User" },
    { "kind": "datastore", "label": "PostgreSQL" },
