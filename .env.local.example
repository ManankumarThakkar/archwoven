# Private/local deployment (§8) — copy to .env.local and adjust.
ARCHWOVEN_MODE=local
OLLAMA_URL=http://localhost:11434
# Ollama model for local inference (~13 GB). Raise to gpt-oss:120b (~65 GB) on ≥64 GB machines.
# OLLAMA_MODEL=gpt-oss:20b
# Only for a production local deployment (docker compose / next start):
# ARCHWOVEN_DEMO_ACK=1
# No ANTHROPIC_API_KEY is read or needed in local mode — inference is Ollama only.
