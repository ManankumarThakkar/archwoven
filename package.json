{
  "name": "archwoven",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter web dev",
    "start:local": "ARCHWOVEN_MODE=local pnpm --filter web start --hostname 127.0.0.1",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "hosting:preflight": "node scripts/hosting-preflight.mjs",
    "bench:selftest": "pnpm --filter @archwoven/model build && node benchmarks/ordinary-model-floor/harness.selftest.mjs && node benchmarks/provider-eval/score.selftest.mjs",
    "build:packages": "pnpm -r --filter \"./packages/**\" build"
  },
  "devDependencies": {
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
